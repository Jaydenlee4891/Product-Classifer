# Copy to .env and fill in. .env is gitignored; .env.example is not, so never put a
# real key in this file.
#   set -a; source .env; set +a

# ---- Anthropic, for Stage 3 (providers 'anthropic' and 'raw') ----------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# Only for an ORGANISATION-level key, which is not tied to a workspace: the API
# rejects it with a 400 naming this header. A workspace-scoped key needs nothing here.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Responses are requested as gzip by default, because some installed combinations of
# httpx2 and a zstd binding raise "TypeError: process() takes no keyword arguments"
# while DECOMPRESSING a reply -- which the SDK re-raises as APIConnectionError, so it
# reads as a network fault although the request already succeeded and was billed. Set
# this once the underlying package conflict is fixed.
# ANTHROPIC_ALLOW_ZSTD=1

# ---- serving ----------------------------------------------------------------
CASCADE_DATA=data
CASCADE_DEVICE=auto
# cached spends nothing (replays data/stage3_fused.csv). anthropic calls live, at
# roughly a third of a cent per escalated request.
CASCADE_PROVIDER=cached

# ---- LangSmith tracing (optional) -------------------------------------------
# Traces only the LangChain path. Provider 'raw' calls the Anthropic SDK directly and
# never appears, so the parity check itself is not visible in the UI. Prompts and
# completions are uploaded -- fine for ABO, which is public, but think before enabling
# it for a full 12,200-item run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=cascade-classifier
# Required outside the US; no trailing slash.
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
